<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Gym Tracker Pro"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymTrackerPro"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false" >

        <!-- Splash Screen - Launcher Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Account registration screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Account login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- My Workouts screen -->
        <activity
            android:name=".WorkoutsActivity"
            android:exported="false" />

        <!-- Main home screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ExercisesActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutExercisesActivity"
            android:exported="false" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutMusicActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ProgramsActivity"
            android:exported="false" />

        <activity
            android:name=".ProgramDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ExerciseDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".TimerActivity"
            android:exported="false" />

        <activity
            android:name=".ActiveWorkoutActivity"
            android:exported="false" />

    </application>

</manifest>

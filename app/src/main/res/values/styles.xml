<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.GymTracker.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Buttons =====
         The base style is applied to EVERY Button in the app via the theme
         (materialButtonStyle), so old screens get rounded buttons for free.
         Use the variants below for more specific roles. -->
    <style name="Widget.GymTracker.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/gt_primary_dark</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.GymTracker.Button.Tonal">
        <item name="backgroundTint">@color/gt_tonal</item>
        <item name="android:textColor">@color/gt_text</item>
    </style>

    <style name="Widget.GymTracker.Button.Danger">
        <item name="backgroundTint">@color/gt_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.GymTracker.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/gt_primary</item>
        <item name="android:textColor">@color/gt_blue</item>
    </style>

    <!-- Light pill button that sits on top of gradient hero cards -->
    <style name="Widget.GymTracker.Button.OnHero">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">#1E3A8A</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ===== Chips ===== -->
    <style name="Widget.GymTracker.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/gt_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GymTracker.Pill</item>
    </style>

</resources>

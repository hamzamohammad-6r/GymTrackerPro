<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- GymTrackerPro is a dark-only app, so we use the Dark parent. -->
    <style name="Base.Theme.GymTrackerPro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gt_blue</item>
        <item name="colorSurface">@color/gt_surface</item>
        <item name="android:windowBackground">@color/gt_background</item>

        <!-- Fixes the purple status bar and unreadable (dark) status icons -->
        <item name="android:statusBarColor">@color/gt_background</item>
        <item name="android:navigationBarColor">@color/gt_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.GymTrackerPro" parent="Base.Theme.GymTrackerPro" />
</resources>
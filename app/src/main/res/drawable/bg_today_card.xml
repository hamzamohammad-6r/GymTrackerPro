<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="22dp" />

    <gradient
        android:angle="135"
        android:startColor="#1D4ED8"
        android:centerColor="#1E3A8A"
        android:endColor="#111C38"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#477FEA" />

    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />

</shape>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_custom_notification"
    android:padding="16dp">

    <TextView
        android:id="@+id/textNotificationIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="ⓘ"
        android:textColor="#60A5FA"
        android:textSize="28sp"
        android:background="#202563EB" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/textNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Workout Setup Required"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Please add a workout and an exercise first."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fitness Goals"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Set targets, stay consistent, and measure your progress."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Goal creation card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create a goal"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Goal name"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editGoalType"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="e.g. Build muscle"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:padding="14dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <!-- Target and current values -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Target value"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editTargetValue"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 70"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current value"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editCurrentValue"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 60"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />

                </LinearLayout>

            </LinearLayout>

            <!-- Target date -->
            <Button
                android:id="@+id/buttonSelectDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Select Target Date"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:backgroundTint="#334155" />

            <!-- Save -->
            <Button
                android:id="@+id/buttonSaveGoal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Save Fitness Goal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB" />

            <Button
                android:id="@+id/buttonRefreshGoals"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Refresh Goals"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:backgroundTint="#334155" />

        </LinearLayout>

        <!-- Saved goals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved Goals"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Your targets and progress"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textGoalsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="#0F172A"
                android:padding="16dp"
                android:text="Loading goals..."
                android:textColor="#CBD5E1"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Fitness Goals"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Set targets and monitor your progress."
            android:textColor="#64748B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editGoalType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Goal name (e.g. Build muscle)"
            android:inputType="textCapSentences"
            android:padding="14dp" />

        <EditText
            android:id="@+id/editTargetValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target value (e.g. 70 kg)"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <EditText
            android:id="@+id/editCurrentValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current value (e.g. 60 kg)"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <EditText
            android:id="@+id/editTargetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target date (YYYY-MM-DD)"
            android:inputType="date"
            android:padding="14dp" />

        <Button
            android:id="@+id/buttonSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save Fitness Goal" />

        <Button
            android:id="@+id/buttonRefreshGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Goals" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SAVED GOALS"
            android:textColor="#172554"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textGoalsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Loading goals..."
            android:textColor="#334155"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>

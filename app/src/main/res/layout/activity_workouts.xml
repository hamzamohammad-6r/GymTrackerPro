<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- Screen heading with back arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/buttonBackArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="←"
                android:textColor="#60A5FA"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back to dashboard" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Workout Planner"
                android:textColor="#F8FAFC"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Plan your training. Track your progress."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Create workout card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create or edit workout"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editWorkoutName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Workout name"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <EditText
                android:id="@+id/editWorkoutDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Select workout date"
                android:focusable="false"
                android:clickable="true"
                android:padding="14dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Training day"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerWorkoutDay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/buttonSaveWorkout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Save Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB" />

        </LinearLayout>

        <!-- Existing workout selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage workouts"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerSelectWorkout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/buttonEditWorkout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Edit Selected Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155" />

            <Button
                android:id="@+id/buttonToggleCompletion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Toggle Completion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D4ED8" />

            <Button
                android:id="@+id/buttonDeleteWorkout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Delete Selected Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B91C1C" />

        </LinearLayout>


        <!-- Workout Schedule Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <!-- Card heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR WORKOUT SCHEDULE"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your exercise plan"
                android:textColor="#F8FAFC"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Review your planned training sessions below."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#29364D" />

            <!-- Existing schedule output: keep this ID -->
            <TextView
                android:id="@+id/textWorkoutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="Your saved workouts will appear here."
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:lineSpacingExtra="8dp"
                android:gravity="top"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

        </LinearLayout>


        <!-- Navigation -->
        <Button
            android:id="@+id/buttonBackHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2563EB"
            android:text="←  Back to Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:elevation="4dp"
            android:stateListAnimator="@null" />


    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:minHeight="155dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/bg_home_tile_neon"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    android:elevation="5dp">

    <!-- Retained for Java compatibility; no photographs displayed -->
    <ImageView
        android:id="@+id/imageTilePhoto"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Neon blue icon -->
    <ImageView
        android:id="@+id/imageTileIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_tile_icon_neon"
        android:contentDescription="@null"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:tint="#FFFFFF" />

    <!-- Tile name -->
    <TextView
        android:id="@+id/textTileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Title"
        android:textColor="#F8FAFC"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Retained for Java compatibility -->
    <TextView
        android:id="@+id/textTileSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Subtitle" />

</LinearLayout>

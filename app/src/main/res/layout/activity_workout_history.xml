<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Workout History"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review your completed and planned workouts."
        android:textSize="14sp"
        android:textColor="#667085"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textHistorySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 0 | Completed: 0 | Planned: 0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/textWorkoutHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading workout history..."
            android:textSize="16sp"
            android:textColor="#344054"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

    <Button
        android:id="@+id/buttonHistoryBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="16dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_midnight_gradient"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the reset token from your backend console and choose a new password."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etResetToken"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#3B82F6"
            android:hint="Reset token"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#3B82F6"
            android:hint="New password (minimum 8 characters)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8" />

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2563EB"
            android:text="Reset Password"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>

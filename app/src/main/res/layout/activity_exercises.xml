<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exercise Library"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Build your exercise collection and organise your training."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Toggle add card -->
        <Button
            android:id="@+id/buttonToggleAdd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="+ Add New Exercise"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB" />

        <!-- Add exercise card (hidden until toggled) -->
        <LinearLayout
            android:id="@+id/cardAddExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add a new exercise"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise name"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editExerciseName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="e.g. Bench Press"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:padding="14dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Muscle group"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerMuscleGroup"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/buttonSaveExercise"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="Save Exercise"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB" />

        </LinearLayout>

        <!-- Saved exercises card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved Exercises"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/textExerciseCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 exercises"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Search -->
            <EditText
                android:id="@+id/editSearchExercise"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Search exercises"
                android:inputType="text"
                android:singleLine="true"
                android:padding="12dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <!-- Muscle group filter chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMuscle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

            </HorizontalScrollView>

            <!-- Empty state -->
            <TextView
                android:id="@+id/textExerciseEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="#0F172A"
                android:padding="16dp"
                android:text="Your saved exercises will appear here."
                android:textColor="#CBD5E1"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

            <!-- Exercise list container (rows added from Java) -->
            <LinearLayout
                android:id="@+id/containerExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Legacy list view, kept so old references don't break. Delete if unused. -->
            <TextView
                android:id="@+id/textExerciseList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Back navigation -->
        <Button
            android:id="@+id/buttonBackHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:backgroundTint="#334155" />

    </LinearLayout>

</ScrollView>
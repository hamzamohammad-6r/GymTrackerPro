<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="GYMTRACKERPRO"
            android:textColor="#60A5FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Create your account"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Set up your profile and start tracking your fitness journey."
            android:textColor="#A8B4CA"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151F33"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL DETAILS"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etRegisterName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3B82F6"
                android:hint="Full name"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3B82F6"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <EditText
                android:id="@+id/etRegisterAge"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3B82F6"
                android:hint="Age"
                android:inputType="number"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <EditText
                android:id="@+id/etRegisterHeight"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3B82F6"
                android:hint="Height (cm)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <EditText
                android:id="@+id/etRegisterWeight"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3B82F6"
                android:hint="Weight (kg)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <EditText
                android:id="@+id/etRegisterFitnessGoal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:hint="Fitness goal (e.g. Build muscle)"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8290A8" />

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#3B82F6"
                android:text="CREATE ACCOUNT"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="YOUR FITNESS JOURNEY STARTS HERE"
            android:textColor="#71819B"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

</ScrollView>

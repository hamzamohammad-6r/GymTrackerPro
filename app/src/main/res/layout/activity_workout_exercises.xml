<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Back to Dashboard arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/buttonBackArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="←"
                android:textColor="#60A5FA"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back to Dashboard" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Workout Builder"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Build your session, set your targets, and track your training."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Workout and exercise selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  |  Select your session"
                android:textColor="#60A5FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workout"
                android:textStyle="bold"
                android:textColor="#CBD5E1"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerWorkouts"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise"
                android:textStyle="bold"
                android:textColor="#CBD5E1"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerExercises"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

        </LinearLayout>

        <!-- Training targets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  |  Training targets"
                android:textColor="#60A5FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Sets and repetitions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sets"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editSets"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 3"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reps per set"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editRepetitions"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 12"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />

                </LinearLayout>

            </LinearLayout>

            <!-- Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weight (kg)"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editWeight"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="e.g. 40"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="12dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <!-- Notes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Training notes (optional)"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editExerciseNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:hint="e.g. Use controlled movements"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top|start"
                android:padding="12dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <Button
                android:id="@+id/buttonAddExerciseToWorkout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="Add Exercise to Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB" />

        </LinearLayout>

        <!-- Assigned exercises -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151F33"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your exercise plan"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercises assigned to your selected workout"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/textAssignedExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="#0F172A"
                android:padding="16dp"
                android:text="Assigned exercises will appear here."
                android:textColor="#CBD5E1"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

        <!-- Back navigation -->
        <Button
            android:id="@+id/buttonBackHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:backgroundTint="#334155" />

    </LinearLayout>

</ScrollView>

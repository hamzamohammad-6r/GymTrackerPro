<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/buttonBackArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="←"
                android:textColor="#60A5FA"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Workout Builder"
                    android:textColor="#F8FAFC"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan every rep. Build your progress."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Intro banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="#172B4D">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR TRAINING PLAN"
                android:textColor="#60A5FA"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Train with purpose."
                android:textColor="#F8FAFC"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Choose a workout, select an exercise, and set your targets."
                android:textColor="#CBD5E1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Step 1: Select workout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  ·  SELECT SESSION"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workout"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerWorkouts"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerExercises"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>

        <!-- Step 2: Training targets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  ·  TRAINING TARGETS"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Sets and reps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sets"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editSets"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 3"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reps per set"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editRepetitions"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="e.g. 12"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:backgroundTint="#3B82F6"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8" />
                </LinearLayout>
            </LinearLayout>

            <!-- Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weight (kg)"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editWeight"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="e.g. 40"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="12dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <!-- Notes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Training notes (optional)"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editExerciseNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:hint="Add technique tips or reminders..."
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top|start"
                android:padding="12dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8" />

            <Button
                android:id="@+id/buttonAddExerciseToWorkout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="＋  Add Exercise to Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB" />
        </LinearLayout>

        <!-- Step 3: Assigned exercise plan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  ·  YOUR EXERCISE PLAN"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:text="Exercises assigned to your selected workout"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textAssignedExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="#0B1120"
                android:padding="16dp"
                android:text="Assigned exercises will appear here."
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>

        <!-- Bottom navigation -->
        <Button
            android:id="@+id/buttonBackHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="←  Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textStyle="bold"
            android:backgroundTint="#334155" />

    </LinearLayout>
</ScrollView>

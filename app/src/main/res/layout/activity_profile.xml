<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- Screen heading with Back to Dashboard arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/buttonBackArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="←"
                android:textColor="#60A5FA"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back to Dashboard" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="My Profile"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Personal details and fitness preferences"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Profile form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151F33"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="PERSONAL INFORMATION"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Full name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Email Address"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Age -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Age"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="Age in years"
                android:inputType="number"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Height -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Height (cm)"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="Height in centimetres"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Weight (kg)"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="Weight in kilograms"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Fitness goal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Fitness Goal"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editFitnessGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#3B82F6"
                android:hint="e.g. Build muscle"
                android:inputType="textCapSentences"
                android:minHeight="52dp"
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Save button -->
            <Button
                android:id="@+id/buttonSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#2563EB"
                android:text="Save Profile"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Your fitness journey, your progress."
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>

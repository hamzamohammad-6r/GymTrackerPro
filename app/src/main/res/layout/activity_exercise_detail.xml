<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/buttonBackExercises"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E293B"
            android:text="← Exercise Library"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/textExerciseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Barbell Back Squat"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textExerciseCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LEGS  •  COMPOUND EXERCISE"
            android:textColor="#60A5FA"
            android:textSize="13sp"
            android:textStyle="bold" />


        <ImageView
            android:id="@+id/imageExerciseIllustration"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Exercise technique illustration"
            android:src="@drawable/exercise_placeholder" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="How to Perform"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textExerciseInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="8dp"
            android:padding="16dp"
            android:text="1. Position the bar securely across your upper back.\n\n2. Stand with your feet about shoulder-width apart.\n\n3. Bend your hips and knees while keeping your back controlled.\n\n4. Push through your feet to return to standing."
            android:textColor="#D7E2F2"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Use a manageable weight and maintain proper technique."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
